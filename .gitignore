cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo

# Conda / venv
.env/
.venv/
conda/
env/

# VSCode
.vscode/
.vscode-server/

# Logs / outputs
logs/
*.log
*.out
*.err

# Program outputs
out_file/

# Data / cache
data/
.cache/


# Scripts / helpers (local only)
*.pt
processed/
raw/
xt-*.py
collect_converged_xmo.py
train_submit.sbatch
check*.py
EOF
